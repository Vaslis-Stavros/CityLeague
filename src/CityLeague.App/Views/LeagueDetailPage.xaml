<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CityLeague.App.Views.LeagueDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:CityLeague.Core.Dtos;assembly=CityLeague.Core"
    xmlns:vm="clr-namespace:CityLeague.App.ViewModels"
    xmlns:controls="clr-namespace:CityLeague.App.Controls"
    x:Name="Page"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#06351A"
    Title="League">

    <ContentPage.Resources>
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource GlassStroke}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{StaticResource GlassFill}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="Root">
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#06351A" Offset="0" />
                    <GradientStop Color="#0B6B2E" Offset="0.45" />
                    <GradientStop Color="#1FA85A" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
        <Ellipse x:Name="GlowOrb"
                 Fill="#33F2A900"
                 WidthRequest="170"
                 HeightRequest="170"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,-24,-40,0" />

        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="ContentBlock"
                                     Padding="18,16,18,28"
                                     Spacing="12"
                                     Opacity="0">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <controls:MinimalBackButton Grid.Column="0" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding League.Name}"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="24"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border Style="{StaticResource GlassPanel}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding League.Status}"
                                       FontFamily="OutfitSemiBold"
                                       FontSize="14"
                                       TextColor="#F2A900" />
                                <Label Grid.Column="1"
                                       Text="{Binding League.SportName}"
                                       FontFamily="OutfitRegular"
                                       FontSize="13"
                                       TextColor="#C8E6C8" />
                            </Grid>
                            <Label Text="{Binding StatusSubtitle}"
                                   FontFamily="OutfitRegular"
                                   FontSize="13"
                                   TextColor="#C8E6C8" />
                            <Label Text="{Binding ProgressLabel}"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="13"
                                   TextColor="White" />
                            <ProgressBar Progress="{Binding League.ProgressFraction}"
                                         ProgressColor="#F2A900"
                                         HeightRequest="8" />
                        </VerticalStackLayout>
                    </Border>

                    <HorizontalStackLayout Spacing="8">
                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="14,10"
                                IsVisible="{Binding League.CanStart}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding StartCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Start league"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="13"
                                   TextColor="{StaticResource Brand}" />
                        </Border>
                        <Border BackgroundColor="#28FFFFFF"
                                Stroke="{StaticResource GlassStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="14,10"
                                IsVisible="{Binding League.CanExtend}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ExtendCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Extend"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="13"
                                   TextColor="White" />
                        </Border>
                        <Border BackgroundColor="#28FFFFFF"
                                Stroke="{StaticResource GlassStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="14,10"
                                IsVisible="{Binding League.CanEnd}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FinishCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Finish early"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="13"
                                   TextColor="White" />
                        </Border>
                        <Border BackgroundColor="#33C0392B"
                                Stroke="#88FF8A80"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="14,10"
                                IsVisible="{Binding League.CanDelete}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Delete"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="13"
                                   TextColor="#FFCDD2" />
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="TEAMS"
                           FontFamily="OutfitRegular"
                           FontSize="12"
                           TextColor="#C8E6C8"
                           CharacterSpacing="1.2"
                           Margin="4,8,0,0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Teams}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dtos:LeagueTeamDto">
                                <Border Style="{StaticResource GlassPanel}">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0"
                                                    WidthRequest="56"
                                                    HeightRequest="56"
                                                    StrokeShape="RoundRectangle 16"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#28FFFFFF">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.UploadLogoCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid>
                                                    <Label Text="Logo"
                                                           FontFamily="OutfitRegular"
                                                           FontSize="11"
                                                           TextColor="#C8E6C8"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                    <Image Source="{Binding LogoUrl}"
                                                           Aspect="AspectFill"
                                                           IsVisible="{Binding LogoUrl, Converter={StaticResource IsStringNotEmpty}}" />
                                                </Grid>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="18"
                                                       TextColor="White">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.RenameTeamCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <Label FontFamily="OutfitRegular" FontSize="13" TextColor="#C8E6C8">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Leader · " />
                                                            <Span Text="{Binding LeaderDisplayName}" FontFamily="OutfitSemiBold" TextColor="White" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label FontFamily="OutfitRegular" FontSize="12" TextColor="#A8D5B5">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Wins}" />
                                                            <Span Text="W  " />
                                                            <Span Text="{Binding Draws}" />
                                                            <Span Text="D  " />
                                                            <Span Text="{Binding Losses}" />
                                                            <Span Text="L" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Grid>
                                        <HorizontalStackLayout Spacing="8">
                                            <Border BackgroundColor="#28FFFFFF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="10,6">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.RenameTeamCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="Rename"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="12"
                                                       TextColor="White" />
                                            </Border>
                                            <Border BackgroundColor="#28FFFFFF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="10,6">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.UploadLogoCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="Logo"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="12"
                                                       TextColor="White" />
                                            </Border>
                                            <Border BackgroundColor="#33F2A900"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="10,6"
                                                    IsVisible="{Binding Source={x:Reference Page}, Path=BindingContext.CanAssignLeaders}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.PickLeaderCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="Set leader"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="12"
                                                       TextColor="#F2A900" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" Margin="4,8,0,0">
                        <Label Grid.Column="0"
                               Text="PLAYERS"
                               FontFamily="OutfitRegular"
                               FontSize="12"
                               TextColor="#C8E6C8"
                               CharacterSpacing="1.2"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,6"
                                IsVisible="{Binding League.CanAddParticipants}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleAddPeopleCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Invite"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource Brand}" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource GlassPanel}" IsVisible="{Binding ShowAddPeople}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="INVITE CONTACTS"
                                   FontFamily="OutfitRegular"
                                   FontSize="12"
                                   TextColor="#C8E6C8"
                                   CharacterSpacing="1.2" />

                            <Border BackgroundColor="#22FFFFFF"
                                    Stroke="{StaticResource GlassStroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="12,8"
                                    IsVisible="{Binding HasInviteCandidates}">
                                <Entry Placeholder="Search contacts"
                                       Text="{Binding InviteSearchQuery}"
                                       BackgroundColor="Transparent"
                                       TextColor="White"
                                       PlaceholderColor="#A8D5B5"
                                       FontFamily="OutfitRegular"
                                       FontSize="14" />
                            </Border>

                            <CollectionView ItemsSource="{Binding InviteCandidates}"
                                            HeightRequest="280"
                                            IsVisible="{Binding HasFilteredInviteCandidates}"
                                            SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SelectableContact">
                                        <Border BackgroundColor="#22FFFFFF"
                                                Stroke="#44FFFFFF"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 16"
                                                Padding="10,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <controls:AvatarView Grid.Column="0"
                                                                     DisplayName="{Binding User.DisplayName}"
                                                                     ImageUrl="{Binding User.AvatarUrl}"
                                                                     Diameter="40"
                                                                     VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                    <Label Text="{Binding User.DisplayName}"
                                                           FontFamily="OutfitSemiBold"
                                                           FontSize="14"
                                                           TextColor="White"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding User.Handle, StringFormat='@{0}'}"
                                                           FontFamily="OutfitRegular"
                                                           FontSize="12"
                                                           TextColor="#A8D5B5"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <controls:RoundCheckBox Grid.Column="2"
                                                                        IsChecked="{Binding IsSelected}"
                                                                        VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <Label Text="No contacts match that search."
                                   FontFamily="OutfitRegular"
                                   FontSize="13"
                                   TextColor="#A8D5B5"
                                   IsVisible="{Binding ShowInviteSearchEmpty}" />

                            <Label Text="All your contacts are already in."
                                   FontFamily="OutfitRegular"
                                   FontSize="13"
                                   TextColor="#A8D5B5"
                                   IsVisible="{Binding HasInviteCandidates, Converter={StaticResource InvertedBool}}" />

                            <Border BackgroundColor="White"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="14,12"
                                    IsVisible="{Binding HasInviteCandidates}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding InviteSelectedCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Add selected"
                                       FontFamily="OutfitSemiBold"
                                       FontSize="14"
                                       TextColor="{StaticResource Brand}"
                                       HorizontalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Participants}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dtos:LeagueParticipantDto">
                                <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    StrokeShape="RoundRectangle 20"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#28FFFFFF">
                                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding DisplayName}"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="15"
                                                       TextColor="White" />
                                                <Label Text="{Binding TeamName, TargetNullValue='Unassigned'}"
                                                       FontFamily="OutfitRegular"
                                                       FontSize="12"
                                                       TextColor="#C8E6C8" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    BackgroundColor="#33F2A900"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="8,4"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding IsLeader}">
                                                <Label Text="Leader"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="11"
                                                       TextColor="#F2A900" />
                                            </Border>
                                        </Grid>

                                        <HorizontalStackLayout Spacing="6"
                                                               IsVisible="{Binding CanChangeTeam}">
                                            <Border BackgroundColor="#28FFFFFF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="10,6">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.MoveParticipantToTeamACommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Source={x:Reference Page}, Path=BindingContext.TeamA.Name, StringFormat='→ {0}'}"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="12"
                                                       TextColor="White" />
                                            </Border>
                                            <Border BackgroundColor="#28FFFFFF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="10,6">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.MoveParticipantToTeamBCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Source={x:Reference Page}, Path=BindingContext.TeamB.Name, StringFormat='→ {0}'}"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="12"
                                                       TextColor="White" />
                                            </Border>
                                            <Border BackgroundColor="#22FFFFFF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="10,6">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.UnassignParticipantCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="Clear"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="12"
                                                       TextColor="#C8E6C8" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="6"
                                                               IsVisible="{Binding Source={x:Reference Page}, Path=BindingContext.CanAssignLeaders}">
                                            <Border BackgroundColor="#33F2A900"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="10,6">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.MakeLeaderOfTeamACommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Source={x:Reference Page}, Path=BindingContext.TeamA.Name, StringFormat='Lead {0}'}"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="12"
                                                       TextColor="#F2A900" />
                                            </Border>
                                            <Border BackgroundColor="#33F2A900"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="10,6">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.MakeLeaderOfTeamBCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Source={x:Reference Page}, Path=BindingContext.TeamB.Name, StringFormat='Lead {0}'}"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="12"
                                                       TextColor="#F2A900" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="MATCH RESULTS"
                           FontFamily="OutfitRegular"
                           FontSize="12"
                           TextColor="#C8E6C8"
                           CharacterSpacing="1.2"
                           Margin="4,8,0,0" />

                    <Border Style="{StaticResource GlassPanel}"
                            IsVisible="{Binding ShowEmptyResults}"
                            Padding="18,22">
                        <Label Text="No finished matches yet."
                               FontFamily="OutfitRegular"
                               FontSize="13"
                               TextColor="#C8E6C8"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MatchResults}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dtos:LeagueMatchResultDto">
                                <Border Style="{StaticResource GlassPanel}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontFamily="OutfitSemiBold"
                                               FontSize="15"
                                               TextColor="White" />
                                        <Label FontFamily="OutfitSemiBold" FontSize="20" TextColor="White">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding HomeScore}" />
                                                    <Span Text=" – " TextColor="#C8E6C8" />
                                                    <Span Text="{Binding AwayScore}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontFamily="OutfitRegular" FontSize="12" TextColor="#C8E6C8">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding HomeTeamName}" />
                                                    <Span Text=" vs " />
                                                    <Span Text="{Binding AwayTeamName}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#FFCDD2"
                           FontFamily="OutfitRegular"
                           FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="White"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
