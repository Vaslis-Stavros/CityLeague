<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CityLeague.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:CityLeague.Core.Dtos;assembly=CityLeague.Core"
    x:Name="Page"
    Title="History">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="12" Spacing="16">

                <Label Text="Past events" FontSize="20" FontAttributes="Bold" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PastEvents}" Spacing="8">
                    <BindableLayout.EmptyView>
                        <Label Text="No completed matches yet." TextColor="#666" Padding="8" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dtos:EventSummaryDto">
                            <Border Padding="14" StrokeThickness="0"
                                    BackgroundColor="White" StrokeShape="RoundRectangle 14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenPastEventCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" />
                                    <Label TextColor="#666">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FormatName}" />
                                                <Span Text="  •  " />
                                                <Span Text="{Binding ScheduledAt, StringFormat='{0:ddd d MMM, HH:mm}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label TextColor="{StaticResource Brand}" FontAttributes="Bold">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Result: " />
                                                <Span Text="{Binding Result.HomeScore}" />
                                                <Span Text=" - " />
                                                <Span Text="{Binding Result.AwayScore}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,8" />

                <Label Text="Completed leagues" FontSize="20" FontAttributes="Bold" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CompletedLeagues}" Spacing="8">
                    <BindableLayout.EmptyView>
                        <Label Text="No completed leagues yet." TextColor="#666" Padding="8" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dtos:LeagueDto">
                            <Border Padding="14" StrokeThickness="0"
                                    BackgroundColor="White" StrokeShape="RoundRectangle 14">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                                    <Border Grid.Row="0" Grid.Column="1" Padding="8,4" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{Binding SportKey, Converter={StaticResource SportColor}, ConverterParameter=light}">
                                        <Label Text="{Binding SportName}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{Binding SportKey, Converter={StaticResource SportColor}}" />
                                    </Border>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" TextColor="#666">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding CompletedMatchCount}" FontAttributes="Bold" />
                                                <Span Text=" matches played  •  " />
                                                <Span Text="{Binding ParticipantCount}" FontAttributes="Bold" />
                                                <Span Text=" players" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" TextColor="#C0392B"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
