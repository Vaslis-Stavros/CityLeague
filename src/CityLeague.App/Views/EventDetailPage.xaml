<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CityLeague.App.Views.EventDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:CityLeague.Core.Dtos;assembly=CityLeague.Core"
    xmlns:vm="clr-namespace:CityLeague.App.ViewModels"
    xmlns:controls="clr-namespace:CityLeague.App.Controls"
    x:Name="Page"
    Shell.NavBarIsVisible="False"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource GlassStroke}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{StaticResource GlassFill}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="GlassAction" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BackgroundColor" Value="White" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="Root">
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#06351A" Offset="0" />
                    <GradientStop Color="#0B6B2E" Offset="0.45" />
                    <GradientStop Color="#1FA85A" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
        <Ellipse x:Name="GlowOrb"
                 Fill="#33F2A900"
                 WidthRequest="170"
                 HeightRequest="170"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,-24,-40,0" />
        <Ellipse Fill="#22FFFFFF"
                 WidthRequest="140"
                 HeightRequest="140"
                 HorizontalOptions="Start"
                 VerticalOptions="End"
                 Margin="-50,0,0,50" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout x:Name="ContentBlock"
                                 Padding="18,16,18,24"
                                 Spacing="12"
                                 Opacity="0">

                <VerticalStackLayout x:Name="HeaderBlock" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="CityLeague"
                               FontFamily="OutfitSemiBold"
                               FontSize="13"
                               TextColor="#DDEFDD"
                               CharacterSpacing="1.2"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                BackgroundColor="#28FFFFFF"
                                Stroke="{StaticResource GlassStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Back"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="12"
                                   TextColor="White" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                        <Label Grid.Column="0"
                               Text="{Binding Title}"
                               FontFamily="OutfitSemiBold"
                               FontSize="26"
                               TextColor="White"
                               LineBreakMode="TailTruncation" />
                        <Border Grid.Column="1"
                                BackgroundColor="#28FFFFFF"
                                Stroke="{StaticResource GlassStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,6"
                                VerticalOptions="Center">
                            <Label Text="{Binding StatusText}"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="12"
                                   TextColor="White" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding ResultText, StringFormat='Result · {0}'}"
                           FontFamily="OutfitSemiBold"
                           FontSize="15"
                           TextColor="#F2A900"
                           IsVisible="{Binding ResultText, Converter={StaticResource IsStringNotEmpty}}" />

                    <Label Text="Tap an open spot to claim it — tap yours to leave."
                           FontFamily="OutfitRegular"
                           FontSize="13"
                           TextColor="#C8E6C8"
                           IsVisible="{Binding IsReadOnly, Converter={StaticResource InvertedBool}}" />
                    <Label Text="Final lineup and result."
                           FontFamily="OutfitRegular"
                           FontSize="13"
                           TextColor="#C8E6C8"
                           IsVisible="{Binding IsReadOnly}" />
                </VerticalStackLayout>

                <!-- Pitch -->
                <Border Style="{StaticResource GlassPanel}" Padding="8">
                    <controls:FootballFieldView x:Name="Field"
                        HeightRequest="300"
                        Positions="{Binding Positions}"
                        CurrentUserId="{Binding CurrentUserId}"
                        IsReadOnly="{Binding IsReadOnly}" />
                </Border>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="#FFCDD2"
                       FontFamily="OutfitRegular"
                       FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}" />

                <!-- Actions -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10"
                      IsVisible="{Binding IsReadOnly, Converter={StaticResource InvertedBool}}">
                    <Border Grid.Column="0"
                            Style="{StaticResource GlassAction}"
                            IsVisible="{Binding CanInvite}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleInvitePanelCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Invite"
                               FontFamily="OutfitSemiBold"
                               FontSize="14"
                               TextColor="{StaticResource Brand}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="#F2A900"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="14,12"
                            IsVisible="{Binding CanSubmitResult}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SubmitResultCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Result"
                               FontFamily="OutfitSemiBold"
                               FontSize="14"
                               TextColor="#1A1520"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border BackgroundColor="#33C0392B"
                        Stroke="#88FF8A80"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14,12"
                        IsVisible="{Binding CanDelete}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Delete match"
                           FontFamily="OutfitSemiBold"
                           FontSize="14"
                           TextColor="#FFCDD2"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Invite panel -->
                <Border Style="{StaticResource GlassPanel}"
                        IsVisible="{Binding ShowInvitePanel}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="INVITE CONTACTS"
                               FontFamily="OutfitRegular"
                               FontSize="12"
                               TextColor="#C8E6C8"
                               CharacterSpacing="1.2" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding InviteCandidates}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableContact">
                                    <Grid ColumnDefinitions="*,Auto" Padding="2,4">
                                        <Label Grid.Column="0"
                                               Text="{Binding User.DisplayName}"
                                               FontFamily="OutfitSemiBold"
                                               FontSize="14"
                                               TextColor="White"
                                               VerticalOptions="Center" />
                                        <Switch Grid.Column="1"
                                                IsToggled="{Binding IsSelected}"
                                                OnColor="{StaticResource Accent}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="All your contacts are already in."
                               FontFamily="OutfitRegular"
                               FontSize="13"
                               TextColor="#A8D5B5"
                               IsVisible="{Binding HasInviteCandidates, Converter={StaticResource InvertedBool}}" />
                        <Border Style="{StaticResource GlassAction}"
                                Margin="0,4,0,0"
                                IsVisible="{Binding HasInviteCandidates}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding InviteSelectedCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Send invites"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="14"
                                   TextColor="{StaticResource Brand}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Players -->
                <Label Text="PLAYERS"
                       FontFamily="OutfitRegular"
                       FontSize="12"
                       TextColor="#C8E6C8"
                       CharacterSpacing="1.2"
                       Margin="4,4,0,0" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Participants}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dtos:ParticipantDto">
                            <Border Style="{StaticResource GlassPanel}" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <controls:AvatarView Grid.Column="0"
                                                         DisplayName="{Binding DisplayName}"
                                                         ImageUrl="{Binding AvatarUrl}"
                                                         Diameter="40" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding DisplayName}"
                                               FontFamily="OutfitSemiBold"
                                               FontSize="15"
                                               TextColor="White" />
                                        <Label Text="{Binding Handle, StringFormat='@{0}'}"
                                               FontFamily="OutfitRegular"
                                               FontSize="12"
                                               TextColor="#A8D5B5" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="Organizer"
                                           FontFamily="OutfitSemiBold"
                                           FontSize="12"
                                           TextColor="#F2A900"
                                           IsVisible="{Binding IsOwner}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="White"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
