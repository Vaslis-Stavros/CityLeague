<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CityLeague.App.Views.CreateEventPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Page"
    Title="New match">

    <Grid RowDefinitions="*,Auto" Padding="18" RowSpacing="14">

        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Spacing="14" VerticalOptions="Start">

                <Label Text="Sport" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding Sports}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedSport}" />

                <Label Text="Format" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding Formats}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedFormat}" />

                <Label Text="Title" FontAttributes="Bold" />
                <Entry Placeholder="e.g. Friday night 7s" Text="{Binding Title}" />

                <Label Text="Date and time" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <DatePicker Grid.Column="0" Date="{Binding Date}" />
                    <TimePicker Grid.Column="1" Time="{Binding Time}" />
                </Grid>

                <Label Text="Location (optional)" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Placeholder="Where are you playing?"
                           Text="{Binding Location}" />
                    <Button Grid.Column="1"
                            Text="📍"
                            WidthRequest="52"
                            Padding="0"
                            Command="{Binding PickLocationCommand}"
                            BackgroundColor="{StaticResource BrandDark}"
                            TextColor="White"
                            SemanticProperties.Description="Pick location from map" />
                </Grid>

                <Label Text="Series (optional)" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding Series}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedSeries}"
                        Title="No series" />
                <Entry Placeholder="...or start a new series" Text="{Binding NewSeriesName}" />
                <Label Text="A series enforces submitting the previous result before the next match."
                       FontSize="11" TextColor="#888" />

                <Label Text="{Binding ErrorMessage}" TextColor="#C0392B"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Button Text="Create match"
                    Command="{Binding CreateCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="{StaticResource Brand}"
                    TextColor="White" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Brand}" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
