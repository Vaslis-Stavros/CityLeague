<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CityLeague.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CityLeague.App.Views"
    Title="CityLeague"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Route="login"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent
        Route="onboarding"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:OnboardingHandlePage}" />

    <TabBar Route="tabs">
        <Tab Title="Home" Route="home" Icon="tab_home.png">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="People" Route="contacts" Icon="tab_contacts.png">
            <ShellContent ContentTemplate="{DataTemplate views:ContactsPage}" />
        </Tab>
        <Tab Title="Create" Route="create" Icon="tab_create.png">
            <ShellContent ContentTemplate="{DataTemplate views:CreateEventPage}" />
        </Tab>
        <Tab Title="Leagues" Route="leagues" Icon="tab_leagues.png">
            <ShellContent ContentTemplate="{DataTemplate views:LeaguesPage}" />
        </Tab>
        <Tab Title="More" Route="more" Icon="tab_more.png">
            <ShellContent ContentTemplate="{DataTemplate views:MorePage}" />
        </Tab>
    </TabBar>

</Shell>
