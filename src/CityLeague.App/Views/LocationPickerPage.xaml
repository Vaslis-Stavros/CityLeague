<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CityLeague.App.Views.LocationPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CityLeague.App.Controls"
    x:Name="Page"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#06351A"
    Title="Pick location">

    <ContentPage.Resources>
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GlassFillLight}, Dark={StaticResource GlassFillDark}}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#06351A" Offset="0" />
                    <GradientStop Color="#0B6B2E" Offset="0.45" />
                    <GradientStop Color="#1FA85A" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto,*,Auto" Padding="18,16,18,18" RowSpacing="12">

            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <controls:MinimalBackButton />
                <Label Text="Pick a pitch"
                       FontFamily="OutfitSemiBold"
                       FontSize="26"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                <Label Text="{Binding FieldsSubtitle}"
                       FontFamily="OutfitRegular"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceMutedLight}, Dark={StaticResource OnSurfaceMutedDark}}" />
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Stroke="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                    StrokeThickness="1"
                    BackgroundColor="#22FFFFFF"
                    StrokeShape="RoundRectangle 22"
                    Padding="0">
                <WebView x:Name="MapWebView"
                         BackgroundColor="Transparent"
                         Navigating="OnMapNavigating" />
            </Border>

            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Border Style="{StaticResource GlassPanel}"
                        IsVisible="{Binding AddressPreview, Converter={StaticResource IsStringNotEmpty}}"
                        Padding="14,12">
                    <Label Text="{Binding AddressPreview}"
                           FontFamily="OutfitSemiBold"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                           LineBreakMode="TailTruncation" />
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            BackgroundColor="#28FFFFFF"
                            Stroke="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UseMyLocationCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="My location"
                               FontFamily="OutfitSemiBold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ConfirmCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Use this place"
                               FontFamily="OutfitSemiBold"
                               FontSize="14"
                               TextColor="{StaticResource Brand}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="#FFCDD2"
                       FontFamily="OutfitRegular"
                       FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="White"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
