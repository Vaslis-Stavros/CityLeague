<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CityLeague.App.Views.EventDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:CityLeague.Core.Dtos;assembly=CityLeague.Core"
    xmlns:vm="clr-namespace:CityLeague.App.ViewModels"
    xmlns:controls="clr-namespace:CityLeague.App.Controls"
    x:Name="Page"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#06351A"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource GlassStroke}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{StaticResource GlassFill}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="GlassAction" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BackgroundColor" Value="White" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="Root">
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#06351A" Offset="0" />
                    <GradientStop Color="#0B6B2E" Offset="0.45" />
                    <GradientStop Color="#1FA85A" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
        <Ellipse x:Name="GlowOrb"
                 Fill="#33F2A900"
                 WidthRequest="170"
                 HeightRequest="170"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,-24,-40,0" />
        <Ellipse Fill="#22FFFFFF"
                 WidthRequest="140"
                 HeightRequest="140"
                 HorizontalOptions="Start"
                 VerticalOptions="End"
                 Margin="-50,0,0,50" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout x:Name="ContentBlock"
                                 Padding="18,16,18,24"
                                 Spacing="12"
                                 Opacity="0">

                <VerticalStackLayout x:Name="HeaderBlock" Spacing="4">
                    <controls:MinimalBackButton />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                        <Label Grid.Column="0"
                               Text="{Binding Title}"
                               FontFamily="OutfitSemiBold"
                               FontSize="26"
                               TextColor="White"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                BackgroundColor="#28FFFFFF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,8"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleScheduleEditorCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding ScheduleLabel}"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="13"
                                   TextColor="#F2A900"
                                   LineBreakMode="TailTruncation" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding StatusText}"
                           FontFamily="OutfitRegular"
                           FontSize="13"
                           TextColor="#C8E6C8" />

                    <Label Text="{Binding ResultText, StringFormat='Result · {0}'}"
                           FontFamily="OutfitSemiBold"
                           FontSize="15"
                           TextColor="#F2A900"
                           IsVisible="{Binding ResultText, Converter={StaticResource IsStringNotEmpty}}" />

                    <Label Text="{Binding HintText}"
                           FontFamily="OutfitRegular"
                           FontSize="13"
                           TextColor="#C8E6C8" />
                </VerticalStackLayout>

                <Border Style="{StaticResource GlassPanel}"
                        IsVisible="{Binding ShowScheduleEditor}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="RESCHEDULE"
                               FontFamily="OutfitRegular"
                               FontSize="12"
                               TextColor="#C8E6C8"
                               CharacterSpacing="1.2" />
                        <DatePicker Date="{Binding EditDate}"
                                    TextColor="White" />
                        <TimePicker Time="{Binding EditTime}"
                                    TextColor="White" />
                        <Border Style="{StaticResource GlassAction}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SaveScheduleCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Save date"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="14"
                                   TextColor="{StaticResource Brand}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Pitch -->
                <Border Style="{StaticResource GlassPanel}" Padding="8">
                    <controls:FootballFieldView x:Name="Field"
                        HeightRequest="300"
                        Positions="{Binding Positions}"
                        CurrentUserId="{Binding CurrentUserId}"
                        IsReadOnly="{Binding PitchReadOnly}" />
                </Border>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="#FFCDD2"
                       FontFamily="OutfitRegular"
                       FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}" />

                <!-- Actions -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            Style="{StaticResource GlassAction}"
                            IsVisible="{Binding CanInvite}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleInvitePanelCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Invite"
                               FontFamily="OutfitSemiBold"
                               FontSize="14"
                               TextColor="{StaticResource Brand}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="#F2A900"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="14,12"
                            IsVisible="{Binding CanSubmitResult}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SubmitResultCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Set result"
                               FontFamily="OutfitSemiBold"
                               FontSize="14"
                               TextColor="#1A1520"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border BackgroundColor="#33C0392B"
                        Stroke="#88FF8A80"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14,12"
                        IsVisible="{Binding CanDelete}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Delete match"
                           FontFamily="OutfitSemiBold"
                           FontSize="14"
                           TextColor="#FFCDD2"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Border Style="{StaticResource GlassAction}"
                        IsVisible="{Binding CanLeave}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LeaveCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Remove from my list"
                           FontFamily="OutfitSemiBold"
                           FontSize="14"
                           TextColor="{StaticResource Brand}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Invite panel -->
                <Border Style="{StaticResource GlassPanel}"
                        IsVisible="{Binding ShowInvitePanel}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="INVITE CONTACTS"
                               FontFamily="OutfitRegular"
                               FontSize="12"
                               TextColor="#C8E6C8"
                               CharacterSpacing="1.2" />

                        <Border BackgroundColor="#22FFFFFF"
                                Stroke="{StaticResource GlassStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="12,8"
                                IsVisible="{Binding HasInviteCandidates}">
                            <Entry Placeholder="Search contacts"
                                   Text="{Binding InviteSearchQuery}"
                                   BackgroundColor="Transparent"
                                   TextColor="White"
                                   PlaceholderColor="#A8D5B5"
                                   FontFamily="OutfitRegular"
                                   FontSize="14" />
                        </Border>

                        <CollectionView ItemsSource="{Binding InviteCandidates}"
                                        HeightRequest="420"
                                        IsVisible="{Binding HasFilteredInviteCandidates}"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableContact">
                                    <Border BackgroundColor="#22FFFFFF"
                                            Stroke="#44FFFFFF"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <controls:AvatarView Grid.Column="0"
                                                                 DisplayName="{Binding User.DisplayName}"
                                                                 ImageUrl="{Binding User.AvatarUrl}"
                                                                 Diameter="40"
                                                                 VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding User.DisplayName}"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="14"
                                                       TextColor="White"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding User.Handle, StringFormat='@{0}'}"
                                                       FontFamily="OutfitRegular"
                                                       FontSize="12"
                                                       TextColor="#A8D5B5"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <controls:RoundCheckBox Grid.Column="2"
                                                                    IsChecked="{Binding IsSelected}"
                                                                    VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="No contacts match that search."
                               FontFamily="OutfitRegular"
                               FontSize="13"
                               TextColor="#A8D5B5"
                               IsVisible="{Binding ShowInviteSearchEmpty}" />

                        <Label Text="All your contacts are already in."
                               FontFamily="OutfitRegular"
                               FontSize="13"
                               TextColor="#A8D5B5"
                               IsVisible="{Binding HasInviteCandidates, Converter={StaticResource InvertedBool}}" />

                        <Border Style="{StaticResource GlassAction}"
                                Margin="0,4,0,0"
                                IsVisible="{Binding HasInviteCandidates}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding InviteSelectedCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Send invites"
                                   FontFamily="OutfitSemiBold"
                                   FontSize="14"
                                   TextColor="{StaticResource Brand}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Players -->
                <Label Text="PLAYERS"
                       FontFamily="OutfitRegular"
                       FontSize="12"
                       TextColor="#C8E6C8"
                       CharacterSpacing="1.2"
                       Margin="4,4,0,0" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Participants}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dtos:ParticipantDto">
                            <Border Style="{StaticResource GlassPanel}" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <controls:AvatarView Grid.Column="0"
                                                         DisplayName="{Binding DisplayName}"
                                                         ImageUrl="{Binding AvatarUrl}"
                                                         Diameter="40" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding DisplayName}"
                                               FontFamily="OutfitSemiBold"
                                               FontSize="15"
                                               TextColor="White" />
                                        <Label Text="{Binding Handle, StringFormat='@{0}'}"
                                               FontFamily="OutfitRegular"
                                               FontSize="12"
                                               TextColor="#A8D5B5" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="Organizer"
                                           FontFamily="OutfitSemiBold"
                                           FontSize="12"
                                           TextColor="#F2A900"
                                           IsVisible="{Binding IsOwner}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="14,12"
                        Margin="0,4,0,0"
                        IsVisible="{Binding CanLock}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LockCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Lock match"
                           FontFamily="OutfitSemiBold"
                           FontSize="15"
                           TextColor="{StaticResource Brand}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Border BackgroundColor="#33FFFFFF"
                        Stroke="#88FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14,12"
                        Margin="0,4,0,0"
                        IsVisible="{Binding CanUnlock}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding UnlockCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Cancel lock"
                           FontFamily="OutfitSemiBold"
                           FontSize="15"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="White"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
