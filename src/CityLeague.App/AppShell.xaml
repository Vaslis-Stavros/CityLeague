<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CityLeague.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CityLeague.App.Views"
    Title="CityLeague"
    FlyoutBehavior="Disabled">

    <ShellContent
        Route="login"
        Shell.NavBarIsVisible="False"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent
        Route="onboarding"
        Title="Choose your handle"
        ContentTemplate="{DataTemplate views:OnboardingHandlePage}" />

    <TabBar Route="tabs">
        <Tab Title="Home" Route="home">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="Contacts" Route="contacts">
            <ShellContent ContentTemplate="{DataTemplate views:ContactsPage}" />
        </Tab>
        <Tab Title="Create" Route="create">
            <ShellContent ContentTemplate="{DataTemplate views:CreateEventPage}" />
        </Tab>
        <Tab Title="Leagues" Route="leagues">
            <ShellContent ContentTemplate="{DataTemplate views:LeaguesPage}" />
        </Tab>
        <Tab Title="History" Route="history">
            <ShellContent ContentTemplate="{DataTemplate views:HistoryPage}" />
        </Tab>
        <Tab Title="Profile" Route="profile">
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>
    </TabBar>

</Shell>
