<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CityLeague.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:CityLeague.Core.Dtos;assembly=CityLeague.Core"
    x:Name="Page"
    Shell.NavBarIsVisible="False"
    Title="History">

    <ContentPage.Resources>
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Stroke" Value="#55FFFFFF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="#38FFFFFF" />
            <Setter Property="StrokeShape" Value="RoundRectangle 22" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="Root">
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E1525" Offset="0" />
                    <GradientStop Color="#1A2740" Offset="0.5" />
                    <GradientStop Color="#2A3F5F" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
        <Ellipse x:Name="GlowOrb"
                 Fill="#33E8B86D"
                 WidthRequest="170"
                 HeightRequest="170"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,-30,-45,0" />
        <Ellipse Fill="#18FFFFFF"
                 WidthRequest="150"
                 HeightRequest="150"
                 HorizontalOptions="Start"
                 VerticalOptions="End"
                 Margin="-50,0,0,60" />

        <Grid RowDefinitions="Auto,*" Padding="0,8,0,0">

            <VerticalStackLayout x:Name="HeaderBlock"
                                 Grid.Row="0"
                                 Padding="22,18,22,8"
                                 Spacing="4"
                                 Opacity="0">
                <Label Text="CityLeague"
                       FontFamily="OutfitSemiBold"
                       FontSize="13"
                       TextColor="#C5D0E0"
                       CharacterSpacing="1.2" />
                <Label Text="History"
                       FontFamily="OutfitSemiBold"
                       FontSize="28"
                       TextColor="White" />
                <Label Text="{Binding HistorySubtitle}"
                       FontFamily="OutfitRegular"
                       FontSize="14"
                       TextColor="#A8B8CC" />
            </VerticalStackLayout>

            <RefreshView Grid.Row="1"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="ListBlock"
                                         Padding="18,0,18,20"
                                         Spacing="12"
                                         Opacity="0">

                        <Label Text="PAST MATCHES"
                               FontFamily="OutfitRegular"
                               FontSize="12"
                               TextColor="#A8B8CC"
                               CharacterSpacing="1.2"
                               Margin="4,4,0,0" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PastEvents}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:EventSummaryDto">
                                    <Border Style="{StaticResource GlassPanel}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenPastEventCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Title}"
                                                   FontFamily="OutfitSemiBold"
                                                   FontSize="16"
                                                   TextColor="White"
                                                   LineBreakMode="TailTruncation" />
                                            <Label FontFamily="OutfitRegular" FontSize="13" TextColor="#A8B8CC">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding FormatName}" />
                                                        <Span Text="  ·  " />
                                                        <Span Text="{Binding ScheduledAt, StringFormat='{0:ddd d MMM, HH:mm}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontFamily="OutfitSemiBold" FontSize="14" TextColor="#E8B86D">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Result.HomeScore}" />
                                                        <Span Text=" – " />
                                                        <Span Text="{Binding Result.AwayScore}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border Style="{StaticResource GlassPanel}"
                                Padding="18,22"
                                IsVisible="{Binding ShowEmptyPastEvents}">
                            <Label Text="No completed matches yet."
                                   FontFamily="OutfitRegular"
                                   FontSize="13"
                                   TextColor="#A8B8CC"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                        <Label Text="COMPLETED LEAGUES"
                               FontFamily="OutfitRegular"
                               FontSize="12"
                               TextColor="#A8B8CC"
                               CharacterSpacing="1.2"
                               Margin="4,10,0,0" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CompletedLeagues}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:LeagueDto">
                                    <Border Style="{StaticResource GlassPanel}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontFamily="OutfitSemiBold"
                                                       FontSize="16"
                                                       TextColor="White"
                                                       LineBreakMode="TailTruncation" />
                                                <Border Grid.Column="1"
                                                        BackgroundColor="#28FFFFFF"
                                                        Stroke="#55FFFFFF"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 12"
                                                        Padding="10,5"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding SportName}"
                                                           FontFamily="OutfitSemiBold"
                                                           FontSize="12"
                                                           TextColor="White" />
                                                </Border>
                                            </Grid>
                                            <Label FontFamily="OutfitRegular" FontSize="13" TextColor="#A8B8CC">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding CompletedMatchCount}" FontFamily="OutfitSemiBold" TextColor="White" />
                                                        <Span Text=" matches  ·  " />
                                                        <Span Text="{Binding ParticipantCount}" FontFamily="OutfitSemiBold" TextColor="White" />
                                                        <Span Text=" players" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border Style="{StaticResource GlassPanel}"
                                Padding="18,22"
                                IsVisible="{Binding ShowEmptyCompletedLeagues}">
                            <Label Text="No completed leagues yet."
                                   FontFamily="OutfitRegular"
                                   FontSize="13"
                                   TextColor="#A8B8CC"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#FFCDD2"
                               FontFamily="OutfitRegular"
                               FontSize="13"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}" />

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="White"
                                           HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
